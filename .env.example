# AWS RDS (usado por las Lambdas como variables de entorno de Lambda)
DB_HOST=tu-instancia.xxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=cambia-esta-contraseña

# Grafana: datasource de PostgreSQL. Déjalas vacías para usar la base local de Docker.
# Para RDS: host con puerto, sslmode=require
SF_DB_HOST=tu-instancia.xxxxxx.us-east-2.rds.amazonaws.com:5432
SF_DB_NAME=postgres
SF_DB_USER=postgres
SF_DB_PASSWORD=cambia-esta-contraseña
SF_DB_SSLMODE=require

# API Gateway Endpoints (Para el simulador)
API_GATEWAY_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod/telemetry
CONTROL_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod/control
